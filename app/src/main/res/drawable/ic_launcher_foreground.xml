<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- TV Outer Frame / Screen (Centered in 108 canvas: 26 to 82 x, 30 to 72 y) -->
    <path
        android:pathData="M32,32 L76,32 A6,6 0 0 1 82,38 L82,68 A6,6 0 0 1 76,74 L32,74 A6,6 0 0 1 26,68 L26,38 A6,6 0 0 1 32,32 Z"
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFF"
        android:fillColor="#1C1822" />

    <!-- TV Screen Display Inside -->
    <path
        android:pathData="M31,37 L77,37 A3,3 0 0 1 80,40 L80,66 A3,3 0 0 1 77,69 L31,69 A3,3 0 0 1 28,66 L28,40 A3,3 0 0 1 31,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="37"
                android:endX="80"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#E62117" />
                <item android:offset="1.0" android:color="#9E0A12" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- TV Stand Base -->
    <path
        android:pathData="M48,74 L46,80 L62,80 L60,74 Z"
        android:fillColor="#8E8E93" />
    <path
        android:pathData="M42,80 L66,80"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- TV Antenna / Modern V-Poles -->
    <path
        android:pathData="M46,32 L38,24"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M62,32 L70,24"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Play Icon Inside TV Screen -->
    <path
        android:pathData="M50,47 L62,53.5 L50,60 Z"
        android:fillColor="#FFFFFF" />

    <!-- "ZO" Ad-Free Shield Badge in Top Right of TV Screen -->
    <path
        android:pathData="M69,39 L78,39 L78,45 C78,49 73.5,52 73.5,52 C73.5,52 69,49 69,45 Z"
        android:fillColor="#00E676" />
    <!-- Checkmark inside Shield -->
    <path
        android:pathData="M71.5,45 L73,46.8 L76,43"
        android:strokeWidth="1.2"
        android:strokeColor="#0B1E12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
